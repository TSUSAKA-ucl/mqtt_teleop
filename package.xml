<?xml version="1.0"?>
<package format="3">
  <name>mqtt_teleop</name>
  <version>0.1.0</version>
  <description>MQTT teleoperation bridge: MQTT joint targets -> oversample + Bessel LPF -> agx_arm_ctrl /control/move_js</description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>libpaho-mqtt-dev</depend>
  <depend>libpaho-mqttpp-dev</depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
