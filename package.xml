<?xml version="1.0"?>
<package format="3">
  <name>mqtt_teleop</name>
  <version>0.1.0</version>
  <description>MQTT teleoperation bridge: MQTT joint targets -> oversample + Bessel LPF -> agx_arm_ctrl /control/move_js</description>
  <maintainer email="tsusaka@ucl.nuee.nagoya-u.ac.jp">Tsusaka@UCL</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>libpaho-mqtt-dev</depend>
  <depend>libpaho-mqttpp-dev</depend>
  <depend>rosidl_default_generators</depend>
  <depend>rosidl_default_runtime</depend>
  <exec_depend>launch_ros</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
